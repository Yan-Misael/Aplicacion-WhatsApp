@startuml
title Base técnica Persona 1 - Arranque de ServerNode con NoOpPeerTransport

skinparam monochrome true
skinparam shadowing false

participant "main()" as MAIN
participant "NodeConfig" as CFG
participant "ServerNode" as SN
participant "MembershipManager" as MM
participant "GlobalUserDirectory" as GUD
participant "DistributedGroupManager" as DGM
participant "LocalSessionManager" as LSM
participant "NoOpPeerTransport" as NOPT
participant "MessageRouter" as MR

MAIN -> CFG : fromFile(config/node1.properties)
CFG --> MAIN : NodeConfig(node1)

MAIN -> SN : new ServerNode(config)

SN -> SN : inicializar clientWorkerPool
SN -> SN : inicializar peerWorkerPool
SN -> SN : inicializar schedulerPool
SN -> SN : inicializar coordinationExecutor

SN -> MM : new MembershipManager(self, peers)
SN -> GUD : new GlobalUserDirectory()
SN -> DGM : new DistributedGroupManager()
SN -> LSM : new LocalSessionManager()
SN -> NOPT : new NoOpPeerTransport(node1)
SN -> MR : new MessageRouter(...)

MAIN -> SN : start()

SN -> SN : log puertos y pools
SN -> SN : log peers configurados
SN -> NOPT : start()
NOPT --> SN : log "NO_OP peer transport iniciado"

SN -> SN : log "Comunicación TCP pendiente de Persona 2"

@enduml