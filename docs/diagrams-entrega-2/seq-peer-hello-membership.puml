@startuml
title Secuencia base Persona 2 - Descubrimiento inicial y membresía

skinparam monochrome true
skinparam shadowing false

participant "node1\nServerNode" as N1
participant "PeerConnectionManager\nnode1" as PCM1
participant "node2\nServerNode" as N2
participant "PeerListener\nnode2" as PL2
participant "PeerMessageHandler\nnode2" as PMH2
participant "MembershipManager\nnode2" as MM2

participant "node3\nServerNode" as N3
participant "PeerListener\nnode3" as PL3
participant "PeerMessageHandler\nnode3" as PMH3
participant "MembershipManager\nnode3" as MM3

== Inicio de listeners ==

N2 -> PL2 : start(peerPort=6002)
N3 -> PL3 : start(peerPort=6003)

== node1 se presenta ante sus peers ==

N1 -> PCM1 : connectToInitialPeers()
PCM1 -> N2 : PEER_HELLO(node1)
N2 -> PL2 : accept(socket)
PL2 -> PMH2 : peerWorkerPool.submit(handler)
PMH2 -> MM2 : addOrUpdateNode(node1)
MM2 --> PMH2 : node1 registrado como ALIVE
PMH2 --> N1 : PEER_HELLO_ACK(node2)

PCM1 -> N3 : PEER_HELLO(node1)
N3 -> PL3 : accept(socket)
PL3 -> PMH3 : peerWorkerPool.submit(handler)
PMH3 -> MM3 : addOrUpdateNode(node1)
MM3 --> PMH3 : node1 registrado como ALIVE
PMH3 --> N1 : PEER_HELLO_ACK(node3)

== Resultado esperado ==

N1 -> N1 : log "Peer detectado: node2"
N1 -> N1 : log "Peer detectado: node3"
N2 -> N2 : log "Peer detectado: node1"
N3 -> N3 : log "Peer detectado: node1"

@enduml