@startuml
title Secuencia - Mensajería grupal distribuida con Lamport

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam wrapWidth 180
skinparam maxMessageSize 180

actor "Cliente A\nusuarioA" as CA
participant "ManejadorCliente\nnode1" as MC1
participant "MessageRouter\nnode1" as MR1
participant "DistributedGroupManager\nnode1" as DGM1
participant "LocalSessionManager\nnode1" as LSM1
participant "LamportClock\nnode1" as LC1
participant "EventLogger\nnode1" as LOG1
participant "PeerTransport\nnode1" as PT1

participant "PeerMessageHandler\nnode2" as PMH2
participant "LamportClock\nnode2" as LC2
participant "EventLogger\nnode2" as LOG2
participant "LocalSessionManager\nnode2" as LSM2
actor "Cliente B\nmiembro remoto" as CB

participant "PeerMessageHandler\nnode3" as PMH3
participant "LamportClock\nnode3" as LC3
participant "EventLogger\nnode3" as LOG3
participant "LocalSessionManager\nnode3" as LSM3
actor "Cliente C\nmiembro remoto" as CC

CA -> MC1 : PaqueteMensaje(usuarioA, grupoX, texto, esGrupo=true)
MC1 -> MR1 : routeGroupMessage(paquete)

MR1 -> DGM1 : groupExists(grupoX)

alt Grupo no existe
  DGM1 --> MR1 : false
  MR1 -> MC1 : PaqueteError("Grupo no existe")
  MC1 -> CA : informar error

else Grupo existe
  DGM1 --> MR1 : true
  MR1 -> DGM1 : isMember(grupoX, usuarioA)

  alt Usuario no pertenece al grupo
    DGM1 --> MR1 : false
    MR1 -> MC1 : PaqueteError("Usuario no pertenece al grupo")
    MC1 -> CA : informar error

  else Usuario autorizado
    DGM1 --> MR1 : true

    MR1 -> DGM1 : getMembersSnapshot(grupoX)
    DGM1 --> MR1 : {usuarioA, usuarioB, usuarioC, ...}

    MR1 -> LSM1 : deliverToLocalGroupMembers(grupoX,\nexcluir usuarioA)
    LSM1 --> MR1 : entregas locales realizadas

    MR1 -> LC1 : tick()
    LC1 --> MR1 : L=n

    MR1 -> LOG1 : logSend("APP_GROUP", node1->*, L=n)

    MR1 -> PT1 : broadcast(AppMessage(APP_GROUP,\ngrupoX, texto,\nlamport=L=n))

    par Entrega remota en node2
      PT1 -> PMH2 : AppMessage(APP_GROUP) por TCP
      PMH2 -> LC2 : update(L=n)
      LC2 --> PMH2 : L=max(local,n)+1
      PMH2 -> LOG2 : logReceive("APP_GROUP", node1->node2, L=m)
      PMH2 -> LSM2 : deliverToLocalGroupMembers(grupoX,\nexcluir usuarioA)
      LSM2 -> CB : entregar mensaje grupal si es miembro local

    else Entrega remota en node3
      PT1 -> PMH3 : AppMessage(APP_GROUP) por TCP
      PMH3 -> LC3 : update(L=n)
      LC3 --> PMH3 : L=max(local,n)+1
      PMH3 -> LOG3 : logReceive("APP_GROUP", node1->node3, L=k)
      PMH3 -> LSM3 : deliverToLocalGroupMembers(grupoX,\nexcluir usuarioA)
      LSM3 -> CC : entregar mensaje grupal si es miembro local
    end

    MR1 -> MC1 : PaqueteConfirm("Mensaje grupal enviado")
    MC1 -> CA : confirmar envío
  end
end

note over MR1,PMH3
El nodo emisor valida existencia del grupo y membresía del usuario.
Luego entrega a miembros locales y difunde el mensaje a peers vivos.
Cada nodo receptor actualiza su reloj de Lamport y entrega solo a sus miembros locales.
end note

@enduml